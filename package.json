{
  "name": "roadmap",
  "displayName": "Roadmap",
  "description": "Gamified dev environment setup — curated & AI-generated setup roadmaps with XP, badges, and streaks",
  "version": "0.1.0",
  "publisher": "roadmap-dev",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:roadmap.run",
    "onCommand:roadmap.generate",
    "onCommand:roadmap.dashboard",
    "onCommand:roadmap.configureBedrock"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "roadmap.run",
        "title": "Roadmap: Run a Roadmap"
      },
      {
        "command": "roadmap.generate",
        "title": "Roadmap: Generate from Goal"
      },
      {
        "command": "roadmap.dashboard",
        "title": "Roadmap: Show Dashboard"
      },
      {
        "command": "roadmap.configureBedrock",
        "title": "Roadmap: Configure Bedrock Credentials"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.11.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  }
}
